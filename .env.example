# LLM (extraction + pre-call brief — see engine/providers/llm_*.py)
LLM_PROVIDER=fake            # fake | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Voice platform — the ONE bought vendor (Bland / Retell / Vapi) behind
# engine/providers/base.py's VoicePlatformProvider. Vendor choice pending;
# "mock" backs engine/providers/mock.py.
VOICE_PLATFORM_PROVIDER=mock
VOICE_PLATFORM_API_KEY=
VOICE_PLATFORM_BASE_URL=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# Cost guardrails — placeholders, not calibrated against real vendor
# per-minute pricing or observed hold durations yet.
CONCURRENCY_CAP=5
JOB_MINUTE_BUDGET=30.0
HOLD_ABANDON_SECONDS=180.0

# Notifications (async job-completion ping)
NOTIFICATION_PROVIDER=mock   # mock | email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Persistence
DATABASE_URL=postgresql+asyncpg://proxy:proxy@localhost:5432/proxy
REDIS_URL=redis://localhost:6379/0
